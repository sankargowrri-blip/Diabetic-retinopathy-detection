# Generated evaluation outputs; these are created by training.
outputs/*
!outputs/.gitkeep
!outputs/metrics.json
!outputs/classification_report.txt
!outputs/baseline_classification_report.txt
!outputs/accuracy.png
!outputs/loss.png
!outputs/confusion_matrix.png
!outputs/baseline_confusion_matrix.png
!outputs/model_comparison.json
