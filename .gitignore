# Python
__pycache__/
*.py[cod]
*.pyd
*.egg-info/
.venv/
venv/
env/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Streamlit and test caches
.streamlit/secrets.toml
